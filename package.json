{
  "name": "portfolio-tech-africain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n mongo,api,client \"npm run mongo\" \"npm run api\" \"npm run client\"",
    "mongo": "node server/startMongo.js",
    "client": "vite --host 0.0.0.0",
    "api": "nodemon server/index.js",
    "seed:admin": "node server/seedAdmin.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.11.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.23",
    "lucide-react": "^0.511.0",
    "mongoose": "^9.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
